# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js — versionamos .next (build precompilado para desplegar en Hostinger),
# pero NO el caché ni artefactos de dev (pesados, no necesarios en runtime).
/.next/cache/
/.next/dev/
/.next/trace
/.next/types/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...pero la plantilla SÍ se versiona (sin secretos)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Companion de brainstorming
.superpowers/
