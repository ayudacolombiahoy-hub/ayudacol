NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=pega-aqui-la-anon-key
# Solo para limpieza de datos de prueba en tests / scripts. NUNCA usar en código de la app cliente.
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-la-service-role-key
# URL pública del sitio (para metadatos al compartir en redes). En producción: https://tudominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Conexión directa a Postgres (solo para scripts de migración/demo; Session pooler)
SUPABASE_DB_URL=postgresql://postgres.REF:CONTRASENA@aws-0-REGION.pooler.supabase.com:5432/postgres
# Número de WhatsApp de la línea de ayuda, formato internacional sin "+" (ej. 573001234567).
# Si se deja vacío, el botón flotante de WhatsApp no se muestra.
NEXT_PUBLIC_WHATSAPP=
